NEXT_PUBLIC_API_URL=http://localhost:3000
API_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Ads conversion tracking (Phase 1b). Leave empty in dev unless testing.
NEXT_PUBLIC_GOOGLE_GTAG_ID=
NEXT_PUBLIC_GOOGLE_CONVERSION_ID=

# Meta Pixel ID — when set, registers the Meta channel in the tag loader.
# When unset, the Meta Pixel is not loaded and no Meta browser events fire.
NEXT_PUBLIC_META_PIXEL_ID=

# TikTok Pixel — 24-char code from Pixel & Events Manager (e.g. CKXXXXXXXXXXXXXXXXXXXXXX).
# Phase 3: when set, browser fires the TikTok pixel + Advanced Matching for
# logged-in users. Server-side CAPI (Events API) needs separate creds via
# PUT /admin/sales-channels/tiktok/credentials.
NEXT_PUBLIC_TIKTOK_PIXEL_CODE=
