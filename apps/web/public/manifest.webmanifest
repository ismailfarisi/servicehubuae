{
	"name": "MyPickUAE",
	"short_name": "MyPickUAE",
	"description": "MyPickUAE UAE marketplace storefront with WebMCP service worker tool support.",
	"start_url": "/en",
	"scope": "/",
	"display": "standalone",
	"background_color": "#ffffff",
	"theme_color": "#2563eb",
	"icons": [
		{
			"src": "/mypickuae-logo.png",
			"sizes": "512x512",
			"type": "image/png"
		}
	],
	"serviceworker": {
		"src": "/webmcp-service-worker.js",
		"scope": "/",
		"use_cache": false
	}
}
