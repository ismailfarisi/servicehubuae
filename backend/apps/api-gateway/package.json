    "@elysiajs/jwt": "^1.2.0",
    "@servicehubuae/config": "workspace:*",
    "@servicehubuae/plugins": "workspace:*",
    "@servicehubuae/guards": "workspace:*",
    "@servicehubuae/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^5.7.0"
  }
