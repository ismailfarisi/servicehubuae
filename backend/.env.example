# ServiceHubUAE backend — environment variables
#
# Copy this file to `backend/.env` and fill in the secrets.
# The `.env` file is gitignored and auto-loaded by docker-compose
# (and by Bun via `bun run --env-file .env` for local dev outside docker).
#
# Only the variables listed as (required) MUST be set.
# Everything else has a sensible development default baked into @servicehubuae/config.

# ─────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────
NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# Database (Postgres)
# Defaults work for the docker-compose postgres service.
# ─────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=servicehubuae
DB_PASSWORD=servicehubuae
DB_NAME=servicehubuae

# ─────────────────────────────────────────────────────────────
# Redis (cache + BullMQ + rate limiting)
# ─────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# BullMQ uses redis://<host>:<port> derived from REDIS_HOST/REDIS_PORT by default.
# Override only if BullMQ should use a different Redis instance.
# BULLMQ_REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────
# Service ports (each backend service listens on its own port)
# ─────────────────────────────────────────────────────────────
GATEWAY_PORT=3000
AUTH_PORT=3001
CATALOG_PORT=3002
VENDOR_PORT=3004
NOTIFICATION_PORT=3005
CMS_PORT=3006
REELS_PORT=3007
INTEGRATION_PORT=3008
BOOKING_PORT=3009

# ─────────────────────────────────────────────────────────────
# Service hosts (used by service-to-service HTTP calls)
# Leave as "localhost" for local dev. Inside docker-compose, the
# compose file overrides these to the service name (e.g. postgres, redis).
# ─────────────────────────────────────────────────────────────
AUTH_HOST=localhost
CATALOG_HOST=localhost
VENDOR_HOST=localhost
NOTIFICATION_HOST=localhost
CMS_HOST=localhost
REELS_HOST=localhost
INTEGRATION_HOST=localhost
BOOKING_HOST=localhost

# ─────────────────────────────────────────────────────────────
# JWT (user auth tokens)
# Dev defaults exist; set these in production.
# ─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret

# ─────────────────────────────────────────────────────────────
# Internal service-to-service auth
# Shared secret passed in the `x-internal-secret` header on
# /internal/* endpoints.
# ─────────────────────────────────────────────────────────────
INTERNAL_SERVICE_SECRET=dev-internal-secret
# NOTIFICATION_SERVICE_URL=http://localhost:3005

# ─────────────────────────────────────────────────────────────
# AWS (S3 media storage, SES email)
# Optional in dev — the media pipeline falls back gracefully.
# ─────────────────────────────────────────────────────────────
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_MEDIA_BUCKET=servicehubuae-media-dev
# CLOUDFRONT_DOMAIN — leave empty to serve media via S3 virtual-hosted URL
# (https://{bucket}.s3.{region}.amazonaws.com/{key}). Set when CloudFront
# is fronting the bucket.
CLOUDFRONT_DOMAIN=
# CLOUDFRONT_DISTRIBUTION_ID=
# S3_ENDPOINT — local dev only. Uncomment to store media on disk via the
# `local-s3` docker-compose service instead of AWS:
#   docker compose up -d local-s3 local-s3-init
# Objects land in backend/.local-s3/objects/<bucket>/. Also set
# AWS_ACCESS_KEY_ID=local-dev, AWS_SECRET_ACCESS_KEY=local-dev-secret and keep
# CLOUDFRONT_DOMAIN empty. Never set S3_ENDPOINT in staging/prod.
# S3_ENDPOINT=http://localhost:7070

# ─────────────────────────────────────────────────────────────
# Typesense (service search index)
# Defaults match the docker-compose typesense service.
# ─────────────────────────────────────────────────────────────
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=dev-typesense-key
TYPESENSE_SERVICES_COLLECTION=service_offerings

# ─────────────────────────────────────────────────────────────
# Payments
# Customer card payments go through MyFatoorah (M2). Until that module ships,
# keep this false: only pay_at_venue offerings can be published and booked.
# ─────────────────────────────────────────────────────────────
ONLINE_PAYMENTS_ENABLED=false

# Stripe — reels licensing charges only (optional; blank disables the rail).
STRIPE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# WhatsApp (Meta Cloud API) — notification channel + OTP
# Leave ACCESS_TOKEN/PHONE_NUMBER_ID blank to disable the channel entirely
# (services boot with a stub dispatcher instead of crashing).
# ─────────────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
# Value we choose; Meta echoes it back during webhook GET verification.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta app secret, used to verify X-Hub-Signature-256 on webhook POSTs.
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Approved authentication-category template used for OTP codes.
WHATSAPP_OTP_TEMPLATE_NAME=otp_code

# Phone OTP provider selection: "twilio" (Twilio Verify), "whatsapp"
# (Meta authentication template + Redis-stored codes), or unset to disable.
SMS_OTP_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ─────────────────────────────────────────────────────────────
# Vendor onboarding
# 32-byte hex key used to encrypt vendor bank account numbers at rest.
# ─────────────────────────────────────────────────────────────
VENDOR_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─────────────────────────────────────────────────────────────
# General-purpose encryption
# 64-char hex (32 bytes) key for AES-256-GCM encryption of stored
# third-party credentials (e.g. vendor integration secrets).
# ─────────────────────────────────────────────────────────────
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─────────────────────────────────────────────────────────────
# 2FA / TOTP
# ─────────────────────────────────────────────────────────────
TWO_FA_ENCRYPTION_KEY=dev-2fa-encryption-key-32bytes!!

# ─────────────────────────────────────────────────────────────
# Reels — Cloudflare Stream (required for upload flow to work)
#
# CLOUDFLARE_STREAM_ACCOUNT_ID — your Cloudflare account ID, found in the right
#   sidebar at https://dash.cloudflare.com on any page.
#
# CLOUDFLARE_STREAM_API_TOKEN — create at My Profile → API Tokens → Create Token
#   → Custom Token with `Stream:Edit` permission scoped to your account.
#
# CLOUDFLARE_STREAM_WEBHOOK_SECRET — API-ONLY, no dashboard UI. Cloudflare Stream
#   allows ONE webhook URL + ONE secret per entire account, managed via the API.
#   Register the webhook and receive the secret in the response with:
#
#     scripts/register-cloudflare-stream-webhook.sh \
#       <account_id> <api_token> https://api.stage.servicehubuae.com/reels/webhooks/cloudflare-stream
#
#   The secret is shown exactly once. If you lose it, re-run the script to roll
#   a new one. If you leave this empty, reels-service starts fine but skips HMAC
#   signature verification on incoming webhooks — acceptable for dev/staging,
#   NOT acceptable for production.
#
# One-secret-per-account gotcha: if staging and prod share a Cloudflare account,
# only one environment can hold the active webhook registration. Use separate
# Cloudflare accounts, or keep staging's secret empty.
#
# Without CLOUDFLARE_STREAM_API_TOKEN, POST /reels/uploads fails. Without
# CLOUDFLARE_STREAM_WEBHOOK_SECRET, incoming webhooks still work but aren't
# authenticated — skip signature check.
# ─────────────────────────────────────────────────────────────
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
# Local dev only — use the `local-stream` docker-compose service instead of
# Cloudflare (ffmpeg transcodes into backend/.local-stream/):
#   docker compose up -d --build local-stream
# Set the three values above to any non-empty strings (e.g. local-dev,
# local-dev-token, local-dev-webhook-secret) and uncomment these two.
# Never set them in staging/prod.
# CLOUDFLARE_STREAM_API_BASE_URL=http://localhost:7071/client/v4
# CLOUDFLARE_STREAM_DELIVERY_BASE_URL=http://localhost:7071

# ─────────────────────────────────────────────────────────────
# Cache TTLs (seconds)
# ─────────────────────────────────────────────────────────────
CATEGORY_TREE_CACHE_TTL=3600
AVAILABILITY_CACHE_TTL=300
