# ─── KMS key for SSM SecureString encryption ──────────────────
resource "aws_kms_key" "ssm" {
  description             = "${var.project_name}-${var.environment} SSM parameter encryption"
  deletion_window_in_days = 30
  enable_key_rotation     = true

  tags = {
    Name        = "${var.project_name}-${var.environment}-ssm"
    Environment = var.environment
    Purpose     = "ssm-encryption"
  }
}

resource "aws_kms_alias" "ssm" {
  name          = "alias/${var.project_name}-${var.environment}-ssm"
  target_key_id = aws_kms_key.ssm.key_id
}

# ─── Secret SSM parameters (structure only — values set by CI) ───────────────
# Empty placeholder on first apply; lifecycle.ignore_changes keeps Terraform
# from clobbering the runtime value the CI job writes.
#
# Note: db/password is intentionally NOT listed here. The RDS master password
# is generated by Terraform in rds.tf and written to /servicehubuae/production/
# db/password by that file directly — do not add it to this CI-synced list.
locals {
  ssm_params = toset([
    "jwt/access-secret",
    "jwt/refresh-secret",
    "internal-service-secret",
    "stripe/secret-key",
    "stripe/connect-webhook",
    "encryption/vendor-key",
    "encryption/key",
    "encryption/two-fa-key",
    "cloudflare/account-id",
    "cloudflare/api-token",
    "cloudflare/webhook-secret",
    "google/drive-api-key",
    "google/gemini-api-key",
    "typesense/api-key",
  ])
}

resource "aws_ssm_parameter" "secret" {
  for_each = local.ssm_params

  name   = "/${var.project_name}/${var.environment}/${each.value}"
  type   = "SecureString"
  key_id = aws_kms_key.ssm.id
  value  = "PLACEHOLDER_SET_BY_CI"

  tags = {
    Environment = var.environment
    Project     = var.project_name
  }

  lifecycle {
    ignore_changes = [value]
  }
}

# ─── Static (non-secret) SSM parameters ──────────────────────────────────────
# Plaintext config the box materialises into .env via refresh-env-from-ssm.sh.
locals {
  ssm_static_params = {
    "integration/host"          = "integration-service"
    "integration/port"          = "3008"
    "integration/service-url"   = "http://integration-service:3008"
    "integration/feed-bucket"   = aws_s3_bucket.channel_feeds.id
    "integration/feed-base-url" = "https://${var.feed_subdomain}"
    # google-merchant-id is provisioned manually via `aws ssm put-parameter`
    # after registering the feed in Google Merchant Center (see runbook). It is
    # intentionally NOT terraformed: the static-parameter resource lacks
    # ignore_changes, so a placeholder here would be clobbered on every apply.
  }
}

resource "aws_ssm_parameter" "static" {
  for_each = local.ssm_static_params

  name  = "/${var.project_name}/${var.environment}/${each.key}"
  type  = "String"
  value = each.value

  tags = {
    Environment = var.environment
    Project     = var.project_name
  }
}
