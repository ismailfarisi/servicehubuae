# All variables have defaults — copy to terraform.tfvars only to override.
#
# github_repo = "ismailfarisi/ecom"
# instance_type     = "t3a.large"
# db_instance_class = "db.t4g.medium"
# cache_node_type   = "cache.t4g.small"
# availability_zone = "ap-south-1b"
# vendor_dashboard_url = "https://vendor.servicehubuae.com"
# admin_panel_url      = "https://admin.servicehubuae.com"
#
# Secrets are NOT set here. They are stored as GitHub Secrets (PROD_*) and
# synced to /servicehubuae/production/* in AWS SSM by the deploy-prod workflow.
# The RDS master password is generated by Terraform and written to
# /servicehubuae/production/db/password automatically.
