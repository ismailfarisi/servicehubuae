{
  "name": "mypickuae",
  "private": true,
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "turbo run dev --concurrency 15",
    "dev:local": "bun scripts/dev-local.ts",
    "dev:web": "turbo run dev --filter=@mypickuae/web",
    "dev:vendor": "turbo run dev --filter=@mypickuae/vendor-dashboard",
    "dev:admin": "turbo run dev --filter=@mypickuae/admin-panel",
    "dev:backend": "turbo run dev --filter=@mypickuae/api-gateway --filter=@mypickuae/auth-service --filter=@mypickuae/product-service --filter=@mypickuae/order-service --filter=@mypickuae/vendor-service --filter=@mypickuae/notification-service --filter=@mypickuae/cms-service"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend/apps/*",
    "backend/libs/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "turbo": "^2.8.21"
  },
  "optionalDependencies": {
    "sharp": "^0.34.5"
  },
  "overrides": {
    "typeorm": "0.3.28"
  }
}